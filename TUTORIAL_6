#include <iostream>
using namespace std;

class Complex
{
    float real, imag;  // Real and imaginary parts

public:
    // Constructor to initialize complex number
    Complex(float r = 0, float i = 0)
    {
        real = r;
        imag = i;
    }

    // Overloading the /= operator
    Complex& operator/=(const Complex& c)
    {
        // Calculate denominator
        float denominator = c.real * c.real + c.imag * c.imag;

        // Check for division by zero
        if (denominator == 0)
        {
            cout << "Error: Division by zero!" << endl;
            return *this;
        }

        // Store original real and imaginary parts
        float r = real;
        float i = imag;

        // Calculate real and imaginary parts of division
        real = (r * c.real + i * c.imag) / denominator;
        imag = (i * c.real - r * c.imag) / denominator;

        return *this;  // Return the updated object
    }

    // Function to display the complex number
    void display()
    {
        cout << real;

        if (imag >= 0)
            cout << " + " << imag << "i" << endl;
        else
            cout << " - " << -imag << "i" << endl;
    }
};

int main()
{
    // Create two complex numbers
    Complex c1(4, 6);
    Complex c2(2, 2);

    cout << "First complex number: ";
    c1.display();

    cout << "Second complex number: ";
    c2.display();

    // Divide c1 by c2 using the overloaded /= operator
    c1 /= c2;

    cout << "Result after division: ";
    c1.display();

    return 0;  // End of program
}
