#include <iostream>
#include <string>
using namespace std;

class String {
private:
    string str;

public:
    
    String(string s) {
        str = s;
    }

    // Display function
    void Display() {
        cout << "String: " << str << endl;
    }
};

int main() {
    String s("Hello, World!");

    s.Display();

    return 0;
}
